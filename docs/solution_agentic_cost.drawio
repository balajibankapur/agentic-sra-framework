<mxfile host="app.diagrams.net" agent="hand-authored" version="24.7.0">
  <diagram name="Agentic cost" id="acost">
    <mxGraphModel dx="1240" dy="360" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="350" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="lead" value="With the agentic pipeline, the &lt;b&gt;same five steps&lt;/b&gt; run as five agents:" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#1A2B5E;" vertex="1" parent="1">
          <mxGeometry x="22" y="14" width="760" height="22" as="geometry" />
        </mxCell>

        <!-- five agents -->
        <mxCell id="s1" value="&lt;b&gt;1. Ingestion&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;color:#4A4C55&quot;&gt;threat queue from Kuzu&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F7FC;strokeColor=#1A2B5E;strokeWidth=2;fontColor=#1A2B5E;fontSize=12;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="22" y="48" width="215" height="66" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;2. Compliance Mapper&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;color:#4A4C55&quot;&gt;clauses from Chroma&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F7FC;strokeColor=#1A2B5E;strokeWidth=2;fontColor=#1A2B5E;fontSize=12;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="267" y="48" width="215" height="66" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;3. Code Analysis&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;color:#4A4C55&quot;&gt;grep over firmware&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F7FC;strokeColor=#1A2B5E;strokeWidth=2;fontColor=#1A2B5E;fontSize=12;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="512" y="48" width="215" height="66" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;⭐ 4. Threat / Control / Risk&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;color:#4A4C55&quot;&gt;CVSS · gaps · fixes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEDE1;strokeColor=#E8620A;strokeWidth=3;fontColor=#1A2B5E;fontSize=12;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="757" y="48" width="215" height="66" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="&lt;b&gt;5. Report Generator&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;color:#4A4C55&quot;&gt;writes the draft entry&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F7FC;strokeColor=#1A2B5E;strokeWidth=2;fontColor=#1A2B5E;fontSize=12;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1002" y="48" width="215" height="66" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=none;html=1;endArrow=classic;endFill=1;strokeColor=#1A2B5E;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s1" target="s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=none;html=1;endArrow=classic;endFill=1;strokeColor=#1A2B5E;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s2" target="s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=none;html=1;endArrow=classic;endFill=1;strokeColor=#1A2B5E;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s3" target="s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=none;html=1;endArrow=classic;endFill=1;strokeColor=#1A2B5E;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s4" target="s5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- span brace + per-threat time -->
        <mxCell id="brace" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;direction=north;flipV=1;strokeColor=#6B7A99;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="22" y="122" width="1195" height="18" as="geometry" />
        </mxCell>
        <mxCell id="pt" value="&lt;b&gt;~30 seconds&lt;/b&gt;  per threat  ·  every claim grounded in the graph and vector index  ·  10 guardrails verify the output" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=13;fontColor=#1A2B5E;" vertex="1" parent="1">
          <mxGeometry x="22" y="146" width="1195" height="22" as="geometry" />
        </mxCell>

        <!-- multiplier -->
        <mxCell id="mult" value="&lt;font style=&quot;font-size:15px&quot;&gt;The same&lt;/font&gt;&#160;&lt;b&gt;&lt;font style=&quot;font-size:26px&quot;&gt;225 threats&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6E4FF;strokeColor=#1A2B5E;strokeWidth=2;fontColor=#1A2B5E;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="140" y="188" width="450" height="72" as="geometry" />
        </mxCell>
        <mxCell id="eq" value="=" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#1A2B5E;" vertex="1" parent="1">
          <mxGeometry x="600" y="208" width="48" height="34" as="geometry" />
        </mxCell>
        <mxCell id="total" value="&lt;b&gt;&lt;font style=&quot;font-size:26px&quot;&gt;under 2 hours&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:13px&quot;&gt;≈ $4 in model calls  ·  vs 450 – 900 hours by hand&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEDE1;strokeColor=#E8620A;strokeWidth=3;fontColor=#1A2B5E;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="655" y="188" width="450" height="72" as="geometry" />
        </mxCell>

        <mxCell id="foot" value="The output is a reviewed draft, not a submission — every entry is approved, edited or rejected by a human before export." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#4A4C55;" vertex="1" parent="1">
          <mxGeometry x="22" y="284" width="1195" height="20" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
