          <mxGeometry x="1080" y="100" width="240" height="50" as="geometry" />
        </mxCell>

        <!-- Vertical timeline lines for each lane -->
        <mxCell id="tl1" value="" style="line;strokeColor=#CADCFC;strokeWidth=1;dashed=1;dashPattern=2 3;" vertex="1" parent="1">
          <mxGeometry x="160" y="150" width="1" height="620" as="geometry" />
        </mxCell>
        <mxCell id="tl2" value="" style="line;strokeColor=#CADCFC;strokeWidth=1;dashed=1;dashPattern=2 3;" vertex="1" parent="1">
