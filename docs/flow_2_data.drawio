        <mxCell id="lane2" value="&lt;b&gt;2. Compliance Mapper&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E2761;strokeColor=#1E2761;fontColor=#FFFFFF;fontSize=13;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="100" width="240" height="50" as="geometry" />
