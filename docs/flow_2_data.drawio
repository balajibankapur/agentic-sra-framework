          <mxGeometry x="940" y="150" width="1" height="620" as="geometry" />
        </mxCell>
        <mxCell id="tl5" value="" style="line;strokeColor=#CADCFC;strokeWidth=1;dashed=1;dashPattern=2 3;" vertex="1" parent="1">
          <mxGeometry x="1200" y="150" width="1" height="620" as="geometry" />
        </mxCell>

        <!-- ================= ARTIFACTS (data blobs) ================= -->

        <!-- Step 1: Ingestion outputs threat_queue -->
        <mxCell id="art1" value="&lt;b&gt;threat_queue&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#666&quot;&gt;[&quot;T-OTA-P01-T&quot;, ...]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3D6;strokeColor=#FFAD1F;strokeWidth=1;fontColor=#1E2761;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="180" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- Arrow: art1 → next stage (Compliance input) -->
        <mxCell id="e-art1-art2in" style="edgeStyle=none;html=1;endArrow=classic;endFill=1;strokeColor=#1E2761;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="art1" target="art2in">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Step 2: Compliance mapper input (current_threat) -->
        <mxCell id="art2in" value="&lt;b&gt;current_threat&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#666&quot;&gt;T-OTA-P01-T&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1;dashed=1;dashPattern=3 3;fontColor=#666666;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="320" y="180" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- Compliance internal calls -->
        <mxCell id="comp-call1" value="&lt;font style=&quot;font-size:10px&quot;&gt;→ graph.cypher: fetch threat + linked controls&lt;br/&gt;→ vector.search(&quot;OTA signature verification&quot;, k=6)&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#1E2761;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="320" y="250" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- Compliance output -->
        <mxCell id="art2out" value="&lt;b&gt;compliance_findings&lt;/b&gt;&lt;br/&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px;color:#666&quot;&gt;FDA-2023-V.B.3 → &lt;b&gt;MISSING&lt;/b&gt;&lt;br/&gt;IEC-CR-3.10 → &lt;b&gt;PARTIAL&lt;/b&gt;&lt;br/&gt;NIST-800-193-4.2 → &lt;b&gt;MISSING&lt;/b&gt;&lt;br/&gt;+ 3 more · with quotes&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3D6;strokeColor=#FFAD1F;strokeWidth=1;fontColor=#1E2761;fontSize=11;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="320" y="310" width="200" height="110" as="geometry" />
        </mxCell>

        <!-- Arrow: art2out → art3in -->
        <mxCell id="e-art2-art3" style="edgeStyle=none;html=1;endArrow=classic;endFill=1;strokeColor=#1E2761;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="art2out" target="art3in">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Step 3: Code Analysis input -->
        <mxCell id="art3in" value="&lt;b&gt;controls to verify&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#666&quot;&gt;CTRL:crc-32-image-check&lt;br/&gt;CTRL:verify-signature (expected)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1;dashed=1;dashPattern=3 3;fontColor=#666666;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="580" y="340" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- Code internal calls -->
        <mxCell id="code-call1" value="&lt;font style=&quot;font-size:10px&quot;&gt;planner: propose grep patterns&lt;br/&gt;→ files.grep(&quot;\\bverify_signature\\b&quot;, firmware/**/*.c)&lt;br/&gt;→ files.grep(&quot;\\bcrc32\\b&quot;, firmware/**/*.c)&lt;br/&gt;interpreter: decide presence&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#1E2761;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="580" y="410" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- Code output -->
        <mxCell id="art3out" value="&lt;b&gt;code_findings&lt;/b&gt;&lt;br/&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px;color:#666&quot;&gt;crc-32 → &lt;b&gt;confirmed&lt;/b&gt;&lt;br/&gt;   at install_handler.c:82&lt;br/&gt;verify_signature → &lt;b&gt;absent&lt;/b&gt;&lt;br/&gt;   0 hits in firmware/&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3D6;strokeColor=#FFAD1F;strokeWidth=1;fontColor=#1E2761;fontSize=11;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="580" y="490" width="200" height="110" as="geometry" />
        </mxCell>

        <!-- Arrow: art3out → art4in -->
        <mxCell id="e-art3-art4" style="edgeStyle=none;html=1;endArrow=classic;endFill=1;strokeColor=#1E2761;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="art3out" target="art4in">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Step 4: TCR input -->
        <mxCell id="art4in" value="&lt;b&gt;evidence bundle&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#666&quot;&gt;threat + compliance_findings&lt;br/&gt;+ code_findings + firmware paths&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1;dashed=1;dashPattern=3 3;fontColor=#666666;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="840" y="510" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- TCR internal work -->
        <mxCell id="tcr-call1" value="&lt;font style=&quot;font-size:10px&quot;&gt;⭐ gpt-4o composes:&lt;br/&gt;→ CVSS vector + score&lt;br/&gt;→ gap analysis with quotes&lt;br/&gt;→ proposed controls&lt;br/&gt;→ proposed code + doc changes&lt;br/&gt;10 guardrails verify output&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#1E2761;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="840" y="580" width="200" height="80" as="geometry" />
        </mxCell>

        <!-- TCR output: SRA Entry -->
        <mxCell id="art4out" value="&lt;b&gt;SRA Entry (12 fields)&lt;/b&gt;&lt;br/&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:9px;color:#666&quot;&gt;threat_id: T-OTA-P01-T&lt;br/&gt;stride: T&lt;br/&gt;cvss: 10.0 Critical&lt;br/&gt;gap_analysis: 6 items&lt;br/&gt;proposed_control:&lt;br/&gt;   CTRL:PROPOSED:ed25519-image-sig&lt;br/&gt;proposed_code_change:&lt;br/&gt;   install_handler.c:82 modify&lt;br/&gt;priority: P0 · effort: 2 wk&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFAD1F;strokeColor=#1E2761;strokeWidth=2;fontColor=#1E2761;fontSize=11;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="840" y="670" width="200" height="130" as="geometry" />
        </mxCell>

        <!-- Arrow: art4out → art5in -->
        <mxCell id="e-art4-art5" style="edgeStyle=none;html=1;endArrow=classic;endFill=1;strokeColor=#1E2761;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="art4out" target="art5in">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Step 5: Report input -->
        <mxCell id="art5in" value="&lt;b&gt;pending_entry&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1;dashed=1;dashPattern=3 3;fontColor=#666666;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1100" y="700" width="200" height="30" as="geometry" />
        </mxCell>

        <!-- Report output: files on disk -->
        <mxCell id="art5out" value="&lt;b&gt;draft.md + draft.json&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#666&quot;&gt;output/pmx100_sra_draft.{md,json}&lt;br/&gt;upsert by threat_id — replaces existing&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3D6;strokeColor=#FFAD1F;strokeWidth=1;fontColor=#1E2761;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1100" y="740" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- FOOTER LEGEND -->
