        <mxCell id="lane4" value="&lt;b&gt;⭐ 4. Threat / Control / Risk&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFAD1F;strokeColor=#1E2761;strokeWidth=3;fontColor=#1E2761;fontSize=13;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="100" width="240" height="50" as="geometry" />
