<mxfile host="app.diagrams.net" agent="hand-authored" version="24.7.0">
  <diagram name="Data flow" id="dataflow">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- HEADER -->
        <mxCell id="title" value="Per-Threat Data Flow — how one threat becomes an SRA entry" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1E2761;" vertex="1" parent="1">
          <mxGeometry x="100" y="20" width="1200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Example: T-OTA-P01-T &quot;Unsigned firmware image accepted at install&quot; · time flows top → bottom" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="100" y="52" width="1200" height="20" as="geometry" />
        </mxCell>

        <!-- ================= AGENT LANES (top) ================= -->
        <!-- 5 agent columns, header at y=100 -->

        <mxCell id="lane1" value="&lt;b&gt;1. Ingestion&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E2761;strokeColor=#1E2761;fontColor=#FFFFFF;fontSize=13;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="240" height="50" as="geometry" />
