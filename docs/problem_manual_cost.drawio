<mxfile host="app.diagrams.net" agent="hand-authored" version="24.7.0">
  <diagram name="Manual cost" id="cost">
    <mxGraphModel dx="1240" dy="360" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="350" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="lead" value="For a &lt;b&gt;single threat&lt;/b&gt;, a security engineer today must:" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#1E2761;" vertex="1" parent="1">
          <mxGeometry x="22" y="14" width="700" height="22" as="geometry" />
        </mxCell>

        <!-- five manual steps -->
        <mxCell id="s1" value="Read the threat&lt;br/&gt;in the threat model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E2761;strokeWidth=2;fontColor=#1E2761;fontSize=12;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="22" y="48" width="215" height="66" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="Hunt through firmware&lt;br/&gt;for the control" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E2761;strokeWidth=2;fontColor=#1E2761;fontSize=12;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="267" y="48" width="215" height="66" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="Map the gap to&lt;br/&gt;FDA · IEC · AAMI · NIST" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E2761;strokeWidth=2;fontColor=#1E2761;fontSize=12;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="512" y="48" width="215" height="66" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="Score CVSS&lt;br/&gt;by hand" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E2761;strokeWidth=2;fontColor=#1E2761;fontSize=12;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="757" y="48" width="215" height="66" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="Write the gap analysis&lt;br/&gt;and remediation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E2761;strokeWidth=2;fontColor=#1E2761;fontSize=12;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1002" y="48" width="215" height="66" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=none;html=1;endArrow=classic;endFill=1;strokeColor=#1E2761;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s1" target="s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=none;html=1;endArrow=classic;endFill=1;strokeColor=#1E2761;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s2" target="s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=none;html=1;endArrow=classic;endFill=1;strokeColor=#1E2761;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s3" target="s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=none;html=1;endArrow=classic;endFill=1;strokeColor=#1E2761;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s4" target="s5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- span brace + per-threat time -->
        <mxCell id="brace" value="" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;direction=north;flipV=1;strokeColor=#9AA3B8;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="22" y="122" width="1195" height="18" as="geometry" />
        </mxCell>
        <mxCell id="pt" value="&lt;b&gt;2 – 4 hours&lt;/b&gt;  per threat  ·  every step is manual search and cross-reference" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=13;fontColor=#1E2761;" vertex="1" parent="1">
          <mxGeometry x="22" y="146" width="1195" height="22" as="geometry" />
        </mxCell>

        <!-- multiplier -->
        <mxCell id="mult" value="&lt;font style=&quot;font-size:15px&quot;&gt;The PMx-100 threat model holds&lt;/font&gt;&#160;&lt;b&gt;&lt;font style=&quot;font-size:26px&quot;&gt;225 threats&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CADCFC;strokeColor=#1E2761;strokeWidth=2;fontColor=#1E2761;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="140" y="188" width="450" height="72" as="geometry" />
        </mxCell>
        <mxCell id="eq" value="=" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#1E2761;" vertex="1" parent="1">
          <mxGeometry x="600" y="208" width="48" height="34" as="geometry" />
        </mxCell>
        <mxCell id="total" value="&lt;b&gt;&lt;font style=&quot;font-size:26px&quot;&gt;450 – 900 hours&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:13px&quot;&gt;≈ 3 – 6 months of one security engineer, per device&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3D6;strokeColor=#FFAD1F;strokeWidth=3;fontColor=#1E2761;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="655" y="188" width="450" height="72" as="geometry" />
        </mxCell>

        <mxCell id="foot" value="Expert-scarce, slow, and inconsistent between reviewers — yet nearly all of it is retrieval over a corpus that already exists." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#666;" vertex="1" parent="1">
          <mxGeometry x="22" y="284" width="1195" height="20" as="geometry" />
