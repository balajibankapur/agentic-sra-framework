<mxfile host="app.diagrams.net" agent="hand-authored" version="24.7.0">
  <diagram name="Technical Architecture" id="tech">
    <mxGraphModel dx="1400" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="840" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ============ TITLE ============ -->
        <mxCell id="title" value="Agentic Architecture — agents, LLM Router, MCP tool layer, data stores" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=21;fontStyle=1;fontColor=#1E2761;" vertex="1" parent="1">
          <mxGeometry x="100" y="18" width="1200" height="32" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="Agents never touch a database or a model provider directly — every call goes through the MCP layer or the LLM Router" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontColor=#666;" vertex="1" parent="1">
          <mxGeometry x="100" y="50" width="1200" height="20" as="geometry" />
        </mxCell>

        <!-- ============ AGENTS BAND ============ -->
        <mxCell id="lbl-agents" value="AGENTS  ·  LangGraph state machine, one node per agent, looped over the threat queue" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#1E2761;letterSpacing=2;" vertex="1" parent="1">
          <mxGeometry x="50" y="88" width="1000" height="18" as="geometry" />
        </mxCell>

        <mxCell id="a1" value="&lt;b&gt;1. Ingestion&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#666&quot;&gt;Builds the ordered threat queue&lt;br/&gt;&lt;br/&gt;&lt;b&gt;no LLM&lt;/b&gt; · deterministic&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E2761;strokeWidth=2;fontColor=#1E2761;fontSize=12;verticalAlign=top;spacingTop=8;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="112" width="245" height="112" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="&lt;b&gt;2. Compliance Mapper&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#666&quot;&gt;Clause verdict: present / partial / missing&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Gemini 2.5 Flash&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E2761;strokeWidth=2;fontColor=#1E2761;fontSize=12;verticalAlign=top;spacingTop=8;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="310" y="112" width="245" height="112" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="&lt;b&gt;3. Code Analysis&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#666&quot;&gt;Planner → Python grep → interpreter&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Groq gpt-oss-120b&lt;/b&gt; ×2&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E2761;strokeWidth=2;fontColor=#1E2761;fontSize=12;verticalAlign=top;spacingTop=8;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="570" y="112" width="245" height="112" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="&lt;b&gt;⭐ 4. Threat / Control / Risk&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#666&quot;&gt;Writes the 12-field SRA entry&lt;br/&gt;&lt;br/&gt;&lt;b&gt;OpenAI gpt-4o&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3D6;strokeColor=#FFAD1F;strokeWidth=3;fontColor=#1E2761;fontSize=12;verticalAlign=top;spacingTop=8;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="830" y="112" width="245" height="112" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="&lt;b&gt;5. Report Generator&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#666&quot;&gt;Atomic upsert into draft.{md,json}&lt;br/&gt;&lt;br/&gt;&lt;b&gt;no LLM&lt;/b&gt; · direct disk&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E2761;strokeWidth=2;fontColor=#1E2761;fontSize=12;verticalAlign=top;spacingTop=8;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1090" y="112" width="245" height="112" as="geometry" />
        </mxCell>

        <!-- ============ ARROWS DOWN ============ -->
        <mxCell id="arr-llm" value="reasoning calls" style="edgeStyle=none;html=1;endArrow=classic;endFill=1;strokeColor=#1E2761;strokeWidth=2;fontSize=10;fontColor=#1E2761;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="260" y="224" as="sourcePoint" />
            <mxPoint x="260" y="284" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="arr-mcp" value="data calls" style="edgeStyle=none;html=1;endArrow=classic;endFill=1;strokeColor=#1E2761;strokeWidth=2;fontSize=10;fontColor=#1E2761;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="930" y="224" as="sourcePoint" />
            <mxPoint x="930" y="284" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ============ LLM ROUTER ============ -->
        <mxCell id="lbl-router" value="LLM ROUTER" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#1E2761;letterSpacing=2;" vertex="1" parent="1">
          <mxGeometry x="50" y="292" width="400" height="18" as="geometry" />
        </mxCell>
        <mxCell id="router" value="&lt;div align=&quot;left&quot;&gt;&lt;b&gt;Why it exists:&lt;/b&gt; agents declare &lt;i&gt;what&lt;/i&gt; they need reasoned about; the Router decides &lt;i&gt;which model&lt;/i&gt; runs it and survives provider failure.&lt;br/&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;· Model selection by profile&lt;/b&gt;&lt;br/&gt;&#160;&#160;&#160;free → Groq + Gemini&#160;&#160;·&#160;&#160;hybrid → free tier + gpt-4o for TCR&#160;&#160;·&#160;&#160;openai → gpt-4o / 4o-mini&lt;br/&gt;&lt;br/&gt;&lt;b&gt;· Retry with backoff&lt;/b&gt; — 3 attempts on rate-limit, timeout, 503&lt;br/&gt;&lt;br/&gt;&lt;b&gt;· Automatic fallback&lt;/b&gt; — spills to &lt;font face=&quot;Courier New&quot;&gt;gpt-4o-mini&lt;/font&gt; when the primary keeps failing, and records the swap in provenance&lt;br/&gt;&lt;br/&gt;&lt;b&gt;· Per-agent output caps&lt;/b&gt; — compliance 8k · TCR 6k · default 4k; flags a truncated response instead of failing silently&lt;br/&gt;&lt;br/&gt;&lt;b&gt;· Logs every turn&lt;/b&gt; to &lt;font face=&quot;Courier New&quot;&gt;prompts.jsonl&lt;/font&gt; — model, tokens, latency, cost, prompt hash&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E2761;strokeWidth=2;fontColor=#1E2761;fontSize=12;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="314" width="420" height="300" as="geometry" />
        </mxCell>

        <!-- ============ MCP LAYER ============ -->
        <mxCell id="lbl-mcp" value="MCP LAYER  ·  Model Context Protocol — one tool contract per backend, guardrails enforced here" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#1E2761;letterSpacing=2;" vertex="1" parent="1">
          <mxGeometry x="510" y="292" width="840" height="18" as="geometry" />
        </mxCell>

        <mxCell id="mcp1" value="&lt;div align=&quot;left&quot;&gt;&lt;b&gt;corpus-graph&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#666&quot;&gt;Python subprocess · JSON-RPC over stdio&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;Tools&lt;/b&gt;&lt;br/&gt;&lt;font face=&quot;Courier New&quot;&gt;cypher · neighbors&lt;br/&gt;path · list_schema&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Guardrail&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#B45309&quot;&gt;Read-only — refuses CREATE, MERGE, DELETE, SET, DROP&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E2761;strokeWidth=2;fontColor=#1E2761;fontSize=12;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="510" y="314" width="270" height="238" as="geometry" />
        </mxCell>
        <mxCell id="mcp2" value="&lt;div align=&quot;left&quot;&gt;&lt;b&gt;corpus-vector&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#666&quot;&gt;Python subprocess · JSON-RPC over stdio&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;Tools&lt;/b&gt;&lt;br/&gt;&lt;font face=&quot;Courier New&quot;&gt;search · get_chunk&lt;br/&gt;list_collections&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Filters&lt;/b&gt;&lt;br/&gt;by kind, category, source; k configurable per call&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E2761;strokeWidth=2;fontColor=#1E2761;fontSize=12;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="795" y="314" width="270" height="238" as="geometry" />
        </mxCell>
        <mxCell id="mcp3" value="&lt;div align=&quot;left&quot;&gt;&lt;b&gt;corpus-files&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#666&quot;&gt;Python subprocess · JSON-RPC over stdio&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;Tools&lt;/b&gt;&lt;br/&gt;&lt;font face=&quot;Courier New&quot;&gt;read · list_dir · grep&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Guardrail&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#B45309&quot;&gt;Path-traversal safe — refuses paths outside the device root; 200 KB read cap&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E2761;strokeWidth=2;fontColor=#1E2761;fontSize=12;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1080" y="314" width="270" height="238" as="geometry" />
        </mxCell>

        <!-- ============ ARROWS TO BOTTOM ROW ============ -->
        <mxCell id="arr-prov" style="edgeStyle=none;html=1;endArrow=classic;endFill=1;strokeColor=#1E2761;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="260" y="614" as="sourcePoint" />
            <mxPoint x="260" y="656" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="arr-d1" value="wraps" style="edgeStyle=none;html=1;endArrow=classic;endFill=1;strokeColor=#1E2761;strokeWidth=2;fontSize=10;fontColor=#666;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="645" y="556" as="sourcePoint" />
            <mxPoint x="645" y="656" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="arr-d2" value="wraps" style="edgeStyle=none;html=1;endArrow=classic;endFill=1;strokeColor=#1E2761;strokeWidth=2;fontSize=10;fontColor=#666;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="930" y="556" as="sourcePoint" />
            <mxPoint x="930" y="656" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="arr-d3" value="wraps" style="edgeStyle=none;html=1;endArrow=classic;endFill=1;strokeColor=#1E2761;strokeWidth=2;fontSize=10;fontColor=#666;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1215" y="556" as="sourcePoint" />
            <mxPoint x="1215" y="656" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ============ LLM PROVIDERS ============ -->
        <mxCell id="lbl-prov" value="MODEL PROVIDERS" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#1E2761;letterSpacing=2;" vertex="1" parent="1">
          <mxGeometry x="50" y="636" width="400" height="18" as="geometry" />
        </mxCell>
        <mxCell id="prov" value="&lt;div align=&quot;left&quot;&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;OpenAI&lt;/b&gt; — &lt;font face=&quot;Courier New&quot;&gt;gpt-4o&lt;/font&gt; (paid, TCR) · &lt;font face=&quot;Courier New&quot;&gt;gpt-4o-mini&lt;/font&gt; (fallback)&lt;br/&gt;&lt;b&gt;Google&lt;/b&gt; — &lt;font face=&quot;Courier New&quot;&gt;gemini-2.5-flash&lt;/font&gt; (free tier)&lt;br/&gt;&lt;b&gt;Groq&lt;/b&gt; — &lt;font face=&quot;Courier New&quot;&gt;gpt-oss-120b&lt;/font&gt; (free tier)&lt;br/&gt;&lt;br/&gt;&lt;font color=&quot;#666&quot;&gt;Reached through LiteLLM — one call signature for all three.&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CADCFC;strokeColor=#1E2761;strokeWidth=2;fontColor=#1E2761;fontSize=12;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="660" width="420" height="128" as="geometry" />
        </mxCell>

        <!-- ============ DATA STORES ============ -->
        <mxCell id="lbl-data" value="DATA STORES" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#1E2761;letterSpacing=2;" vertex="1" parent="1">
          <mxGeometry x="510" y="636" width="840" height="18" as="geometry" />
        </mxCell>

        <mxCell id="db1" value="&lt;div align=&quot;left&quot;&gt;&lt;b&gt;Kuzu&lt;/b&gt;&#160;&#160;&lt;font style=&quot;font-size:10px;color:#666&quot;&gt;embedded property graph&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;2,181 nodes · 1,636 edges&lt;br/&gt;11 node tables · 8 rel tables&lt;br/&gt;&lt;font color=&quot;#666&quot;&gt;Threat ↔ Control ↔ Requirement ↔ CodeArtifact traceability. Runs in-process, no server.&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CADCFC;strokeColor=#1E2761;strokeWidth=2;fontColor=#1E2761;fontSize=12;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="510" y="660" width="270" height="128" as="geometry" />
        </mxCell>
        <mxCell id="db2" value="&lt;div align=&quot;left&quot;&gt;&lt;b&gt;Chroma&lt;/b&gt;&#160;&#160;&lt;font style=&quot;font-size:10px;color:#666&quot;&gt;persistent vector DB&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;2,555 chunks · 3 collections&lt;br/&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:10px&quot;&gt;device_docs · device_code · regulatory&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#666&quot;&gt;Semantic retrieval over design docs and the 24-clause regulatory corpus.&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CADCFC;strokeColor=#1E2761;strokeWidth=2;fontColor=#1E2761;fontSize=12;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="795" y="660" width="270" height="128" as="geometry" />
        </mxCell>
        <mxCell id="db3" value="&lt;div align=&quot;left&quot;&gt;&lt;b&gt;Filesystem&lt;/b&gt;&#160;&#160;&lt;font style=&quot;font-size:10px;color:#666&quot;&gt;raw corpus on disk&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;input/&amp;lt;device&amp;gt;/&lt;/font&gt; — 140 files, 9.7 MB&lt;br/&gt;&lt;font face=&quot;Courier New&quot;&gt;firmware/**/*.[ch]&lt;/font&gt; — 72 files&lt;br/&gt;&lt;font color=&quot;#666&quot;&gt;Ground truth for whether a control exists in code.&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CADCFC;strokeColor=#1E2761;strokeWidth=2;fontColor=#1E2761;fontSize=12;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1080" y="660" width="270" height="128" as="geometry" />
        </mxCell>

        <!-- ============ FOOTER ============ -->
        <mxCell id="foot" value="10 guardrails run over every LLM output (4 hard-fail: schema · CVSS · citation-in-graph · quote-substring)   ·   every entry is approved, edited or rejected by a human before export" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#666;" vertex="1" parent="1">
          <mxGeometry x="100" y="802" width="1200" height="18" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
