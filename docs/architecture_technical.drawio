        <mxCell id="router" value="&lt;div align=&quot;left&quot;&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;i&gt;Agents ask for reasoning; the Router picks the model and survives provider failure.&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;· Model per profile&lt;/b&gt; — free · hybrid · openai&lt;br/&gt;&lt;b&gt;· Retry ×3&lt;/b&gt; on rate-limit / timeout / 503&lt;br/&gt;&lt;b&gt;· Fallback&lt;/b&gt; to &lt;font face=&quot;Courier New&quot;&gt;gpt-4o-mini&lt;/font&gt;, logged in provenance&lt;br/&gt;&lt;b&gt;· Output caps per agent&lt;/b&gt; — 8k / 6k / 4k&lt;br/&gt;&lt;b&gt;· Logs every turn&lt;/b&gt; — model, tokens, cost, latency&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E2761;strokeWidth=2;fontColor=#1E2761;fontSize=12;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=8;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="220" width="420" height="150" as="geometry" />
        </mxCell>

        <!-- MCP LAYER -->
