        <mxCell id="mcp1" value="&lt;div align=&quot;left&quot;&gt;&lt;b&gt;corpus-graph&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#666&quot;&gt;subprocess · JSON-RPC / stdio&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:10px&quot;&gt;cypher · neighbors&lt;br/&gt;path · list_schema&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#B45309&quot;&gt;&lt;b&gt;Read-only&lt;/b&gt; — no CREATE / MERGE / DELETE&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E2761;strokeWidth=2;fontColor=#1E2761;fontSize=12;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;shadow=1;" vertex="1" parent="1">
