<mxfile host="app.diagrams.net" agent="hand-authored" version="24.7.0">
  <diagram name="Architecture" id="arch">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ================= TITLE ================= -->
        <mxCell id="title" value="Agentic SRA Framework" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1E2761;" vertex="1" parent="1">
          <mxGeometry x="200" y="30" width="800" height="34" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Vector + Graph indices · 5 agents · human-in-the-loop review" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="200" y="62" width="800" height="20" as="geometry" />
        </mxCell>

        <!-- ================= TOP FLOW: 5 BOXES IN A ROW (y=140) ================= -->

        <mxCell id="b1" value="&lt;b&gt;Device Corpus&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#666&quot;&gt;docs · firmware · threat model&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E2761;strokeWidth=2;fontColor=#1E2761;fontSize=13;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="140" width="200" height="130" as="geometry" />
        </mxCell>

        <mxCell id="b2" value="&lt;b&gt;Vector + Graph indices&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;color:#1E2761&quot;&gt;Chroma (vector DB)&lt;br/&gt;Kuzu (graph DB)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CADCFC;strokeColor=#1E2761;strokeWidth=2;fontColor=#1E2761;fontSize=13;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="290" y="140" width="200" height="130" as="geometry" />
        </mxCell>

        <mxCell id="b3" value="&lt;b&gt;5 Agents (LangGraph)&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#CADCFC&quot;&gt;1 · 2 · 3 · &lt;font color=&quot;#FFAD1F&quot;&gt;⭐ 4&lt;/font&gt; · 5&lt;br/&gt;details below ↓&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E2761;strokeColor=#1E2761;strokeWidth=2;fontColor=#FFFFFF;fontSize=13;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="530" y="140" width="240" height="130" as="geometry" />
        </mxCell>

        <mxCell id="b4" value="&lt;b&gt;Reviewer&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#666&quot;&gt;Streamlit UI&lt;br/&gt;approve · edit · reject&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E2761;strokeWidth=2;fontColor=#1E2761;fontSize=13;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="810" y="140" width="160" height="130" as="geometry" />
        </mxCell>

        <mxCell id="b5" value="&lt;b&gt;Final SRA&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#666&quot;&gt;PDF · DOCX · JSON&lt;br/&gt;+ provenance&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E2761;strokeWidth=2;fontColor=#1E2761;fontSize=13;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1010" y="140" width="140" height="130" as="geometry" />
        </mxCell>

        <!-- ================= TOP-ROW ARROWS ================= -->
        <mxCell id="a1" value="index" style="edgeStyle=none;html=1;endArrow=classic;endFill=1;strokeColor=#1E2761;strokeWidth=2;fontSize=10;fontColor=#666;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b1" target="b2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="reason" style="edgeStyle=none;html=1;endArrow=classic;endFill=1;strokeColor=#1E2761;strokeWidth=2;fontSize=10;fontColor=#666;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b2" target="b3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="draft" style="edgeStyle=none;html=1;endArrow=classic;endFill=1;strokeColor=#1E2761;strokeWidth=2;fontSize=10;fontColor=#666;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b3" target="b4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="export" style="edgeStyle=none;html=1;endArrow=classic;endFill=1;strokeColor=#1E2761;strokeWidth=2;fontSize=10;fontColor=#666;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b4" target="b5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ================= DIVIDER + LABEL FOR AGENT DETAIL ROW ================= -->
        <mxCell id="detail-label" value="What each agent does" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#1E2761;letterSpacing=2;" vertex="1" parent="1">
          <mxGeometry x="200" y="320" width="800" height="24" as="geometry" />
        </mxCell>
        <mxCell id="detail-divider" value="" style="line;strokeColor=#CADCFC;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="350" width="1100" height="1" as="geometry" />
        </mxCell>

        <!-- ================= AGENT DETAIL ROW (y=370) ================= -->
        <!-- 5 cards, each 220w × 200h, gaps of 10px so total 1150 fits in 1200 -->

        <mxCell id="d1" value="&lt;div align=&quot;left&quot;&gt;&lt;b&gt;1. Ingestion&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Pulls the threat queue from the Kuzu graph in one Cypher query, ordered by priority (or by round-robin across code subsystems for pilots).&lt;br/&gt;&lt;br/&gt;&lt;font color=&quot;#666&quot;&gt;deterministic · no LLM&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CADCFC;strokeWidth=2;fontColor=#1E2761;fontSize=11;verticalAlign=top;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="370" width="220" height="220" as="geometry" />
        </mxCell>

        <mxCell id="d2" value="&lt;div align=&quot;left&quot;&gt;&lt;b&gt;2. Compliance Mapper&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;For each threat, retrieves candidate FDA/IEC/AAMI/NIST clauses from Chroma and walks the graph for linked controls. Decides &lt;i&gt;present / partial / missing&lt;/i&gt; per clause with a verbatim quote.&lt;br/&gt;&lt;br/&gt;&lt;font color=&quot;#666&quot;&gt;Gemini 2.5 Flash&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CADCFC;strokeWidth=2;fontColor=#1E2761;fontSize=11;verticalAlign=top;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="370" width="220" height="220" as="geometry" />
        </mxCell>

        <mxCell id="d3" value="&lt;div align=&quot;left&quot;&gt;&lt;b&gt;3. Code Analysis&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Two-turn agent. Planner proposes grep patterns for each claimed control; Python runs them against &lt;font face=&quot;Courier New&quot;&gt;firmware/**/*.[ch]&lt;/font&gt;; interpreter decides &lt;i&gt;confirmed / insufficient / absent&lt;/i&gt; with file:line citations.&lt;br/&gt;&lt;br/&gt;&lt;font color=&quot;#666&quot;&gt;Groq gpt-oss-120b (×2)&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CADCFC;strokeWidth=2;fontColor=#1E2761;fontSize=11;verticalAlign=top;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="510" y="370" width="220" height="220" as="geometry" />
        </mxCell>

        <mxCell id="d4" value="&lt;div align=&quot;left&quot;&gt;&lt;b&gt;⭐ 4. Threat / Control / Risk&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;The only agent that produces SRA content. Composes the 12-field entry: CVSS v3.1 vector + score, gap analysis, proposed controls, proposed doc + code changes, priority, effort.&lt;br/&gt;&lt;br/&gt;&lt;font color=&quot;#666&quot;&gt;&lt;b&gt;OpenAI gpt-4o&lt;/b&gt; · 10 guardrails run over output&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3D6;strokeColor=#FFAD1F;strokeWidth=3;fontColor=#1E2761;fontSize=11;verticalAlign=top;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="740" y="370" width="220" height="220" as="geometry" />
        </mxCell>

        <mxCell id="d5" value="&lt;div align=&quot;left&quot;&gt;&lt;b&gt;5. Report Generator&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Upserts each finalized entry into &lt;font face=&quot;Courier New&quot;&gt;draft.md&lt;/font&gt; and &lt;font face=&quot;Courier New&quot;&gt;draft.json&lt;/font&gt; by threat_id — reruns replace, they don't duplicate. Write is atomic so a crash mid-run keeps every completed entry.&lt;br/&gt;&lt;br/&gt;&lt;font color=&quot;#666&quot;&gt;deterministic · no LLM&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CADCFC;strokeWidth=2;fontColor=#1E2761;fontSize=11;verticalAlign=top;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="970" y="370" width="220" height="220" as="geometry" />
        </mxCell>

        <!-- ================= FOOTER CAPTION ================= -->
        <mxCell id="footer" value="GraphRAG · MCP tool boundary · guardrails on LLM output · reproducible provenance" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="100" y="640" width="1000" height="20" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
