        </mxCell>
        <mxCell id="subtitle" value="Legacy corpus → indexed → agents through MCP → reviewer UI → signed-off SRA" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#666666;" vertex="1" parent="1">
