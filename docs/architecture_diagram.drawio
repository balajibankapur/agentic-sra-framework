        <!-- 5 agents at y=840, width=240, height=110, gap=20 (5×240 + 4×20 = 1280) -->
        <mxCell id="agent-ingestion" value="&lt;b&gt;1. Ingestion&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#CADCFC&quot;&gt;deterministic Cypher&lt;br/&gt;no LLM&lt;br/&gt;→ threat queue&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E2761;strokeColor=#1E2761;strokeWidth=1;fontColor=#FFFFFF;fontSize=13;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
