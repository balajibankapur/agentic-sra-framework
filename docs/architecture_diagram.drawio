        <mxCell id="agent-report" value="&lt;b&gt;5. Report Generator&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#CADCFC&quot;&gt;deterministic&lt;br/&gt;upsert by threat_id&lt;br/&gt;→ draft.md + draft.json&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E2761;strokeColor=#1E2761;strokeWidth=1;fontColor=#FFFFFF;fontSize=13;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1080" y="840" width="240" height="110" as="geometry" />
        </mxCell>

        <!-- Guardrail callout — right of the agent row -->
        <mxCell id="guardrails" value="&lt;b&gt;Guardrail Layer&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;color:#666666&quot;&gt;10 checks over LLM output&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px&quot;&gt;&lt;b&gt;Hard-fail (4):&lt;/b&gt;&lt;br/&gt;   schema · cvss · citation · quote&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Soft-warn (6):&lt;/b&gt;&lt;br/&gt;   banned_crypto · legacy_taxonomy&lt;br/&gt;   scope · citation_verify_file&lt;br/&gt;   prompt-injection delimit · token cap&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E2761;strokeWidth=1;dashed=1;dashPattern=6 3;fontColor=#1E2761;fontSize=13;verticalAlign=top;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1340" y="840" width="240" height="170" as="geometry" />
