        <!-- 3 indices at y=380, width=480, height=140, gap=20 -->
        <mxCell id="idx-chroma" value="&lt;b style=&quot;font-size:16px&quot;&gt;Chroma vector DB&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;semantic search over text&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px;color:#666666&quot;&gt;• device_docs — 2155 chunks (items + narrative)&lt;br/&gt;• device_code — 403 firmware functions (tree-sitter)&lt;br/&gt;• regulatory — 24 clause bodies (FDA/IEC/AAMI/NIST)&lt;br/&gt;embeddings: OpenAI text-embedding-3-large, 3072d&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CADCFC;strokeColor=#1E2761;strokeWidth=2;fontColor=#1E2761;fontSize=12;verticalAlign=top;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="480" height="150" as="geometry" />
        </mxCell>
        <mxCell id="idx-kuzu" value="&lt;b style=&quot;font-size:16px&quot;&gt;Kuzu graph DB&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;typed relationships between entities&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px;color:#666666&quot;&gt;• 2181 nodes · 11 tables (Threat, Vulnerability,&lt;br/&gt;   CodeArtifact, Control, Requirement, DFDElement …)&lt;br/&gt;• 1636 edges · 8 rel types (APPLIES_TO, LOCATED_IN,&lt;br/&gt;   MITIGATES, TRACES_TO, REALIZES, IMPLEMENTS …)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CADCFC;strokeColor=#1E2761;strokeWidth=2;fontColor=#1E2761;fontSize=12;verticalAlign=top;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="380" width="480" height="150" as="geometry" />
        </mxCell>
        <mxCell id="idx-fs" value="&lt;b style=&quot;font-size:16px&quot;&gt;Filesystem (input/&amp;lt;device&amp;gt;/)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px&quot;&gt;read-only cloned corpus&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;div align=&quot;left&quot; style=&quot;font-size:10px;color:#666666&quot;&gt;• 140 files · 9.7 MB · commit SHA pinned&lt;br/&gt;• firmware/**/*.c,*.h — 72 files&lt;br/&gt;• corpus/&amp;lt;device&amp;gt;/*.md — SRS/SDD/SDS/SAD/…&lt;br/&gt;used for grep + full-file reads by Code Analysis&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CADCFC;strokeColor=#1E2761;strokeWidth=2;fontColor=#1E2761;fontSize=12;verticalAlign=top;shadow=1;" vertex="1" parent="1">
