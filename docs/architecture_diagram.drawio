        <!-- Input boxes — 5 across at y=170, height=100, width=280, gap=20 -->
        <mxCell id="input-corpus" value="&lt;b&gt;Legacy Device Corpus&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;GitHub repo cloned once&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 10px&quot;color=&quot;#666666&quot;&gt;SAD · SRS · SDD · SDS · threat model&lt;br/&gt;firmware C/H · vuln plan · manuals&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CADCFC;strokeWidth=2;fontColor=#1E2761;fontSize=12;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="input-regulatory" value="&lt;b&gt;Regulatory Corpus&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;24 clauses hand-authored&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 10px&quot;color=&quot;#666666&quot;&gt;FDA 2023 · IEC 62443-4-2&lt;br/&gt;AAMI TIR57 · NIST 800-193&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CADCFC;strokeWidth=2;fontColor=#1E2761;fontSize=12;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="170" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="input-llm" value="&lt;b&gt;LLM Providers&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;via LiteLLM router&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 10px&quot;color=&quot;#666666&quot;&gt;OpenAI (paid, TCR agent)&lt;br/&gt;Groq · Gemini (free tier, others)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CADCFC;strokeWidth=2;fontColor=#1E2761;fontSize=12;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="170" width="280" height="110" as="geometry" />
