        <!-- ================= HEADER ================= -->
        <mxCell id="title" value="Agentic SRA Framework — Architecture" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1;fontColor=#1E2761;" vertex="1" parent="1">
