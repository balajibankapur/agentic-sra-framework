          <mxGeometry x="300" y="840" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="agent-code" value="&lt;b&gt;3. Code Analysis&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#CADCFC&quot;&gt;Groq gpt-oss-120b (×2)&lt;br/&gt;planner → grep → interpreter&lt;br/&gt;→ code findings&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E2761;strokeColor=#1E2761;strokeWidth=1;fontColor=#FFFFFF;fontSize=13;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="560" y="840" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="agent-tcr" value="&lt;b&gt;⭐ 4. Threat / Control / Risk&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;OpenAI gpt-4o (paid)&lt;br/&gt;the only agent producing SRA content&lt;br/&gt;12-field entry: CVSS · gap analysis&lt;br/&gt;proposed doc + code changes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFAD1F;strokeColor=#1E2761;strokeWidth=3;fontColor=#1E2761;fontSize=13;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="820" y="840" width="240" height="110" as="geometry" />
