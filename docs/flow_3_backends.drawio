        <mxCell id="mcp-graph" value="&lt;b&gt;corpus-graph MCP&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#666&quot;&gt;cypher · neighbors · path · list_schema&lt;br/&gt;&lt;b color=&quot;#1E2761&quot;&gt;Read-only guardrail:&lt;/b&gt; CREATE/MERGE/DELETE refused&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E2761;strokeWidth=2;fontColor=#1E2761;fontSize=12;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
