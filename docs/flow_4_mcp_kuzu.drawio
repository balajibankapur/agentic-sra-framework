<mxfile host="app.diagrams.net" agent="hand-authored" version="24.7.0">
  <diagram name="MCP-Kuzu" id="mcp_kuzu">
    <mxGraphModel dx="1300" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1240" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ================= TITLE ================= -->
        <mxCell id="title" value="MCP in this framework — how agents read the Kuzu graph" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1E2761;" vertex="1" parent="1">
          <mxGeometry x="150" y="30" width="1000" height="34" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Read as three parts:  what an MCP server is  ·  one call end-to-end  ·  how the server is started" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontColor=#666;" vertex="1" parent="1">
          <mxGeometry x="150" y="62" width="1000" height="20" as="geometry" />
        </mxCell>

        <!-- ================= SECTION 1: WHAT ================= -->
        <mxCell id="s1-label" value="1 · WHAT AN MCP SERVER IS, CONCRETELY" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#1E2761;letterSpacing=2;" vertex="1" parent="1">
          <mxGeometry x="50" y="100" width="700" height="20" as="geometry" />
        </mxCell>

        <mxCell id="w1" value="&lt;b&gt;A Python subprocess&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;When the pipeline starts, it spawns &lt;font face=&quot;Courier New&quot;&gt;corpus-graph&lt;/font&gt; as a child process.&lt;br/&gt;&lt;br/&gt;No network port. No HTTP. The parent process talks to the child over the child's stdin / stdout." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E2761;strokeWidth=2;fontColor=#1E2761;fontSize=12;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="130" width="390" height="180" as="geometry" />
        </mxCell>

        <mxCell id="w2" value="&lt;b&gt;Speaks JSON-RPC over stdio&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Every tool call is one JSON line written to the child's stdin.&lt;br/&gt;Every result is one JSON line read from the child's stdout.&lt;br/&gt;&lt;br/&gt;Framing is handled by the MCP Python SDK (&lt;font face=&quot;Courier New&quot;&gt;stdio_client&lt;/font&gt;). The agent code never touches the wire format." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E2761;strokeWidth=2;fontColor=#1E2761;fontSize=12;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="455" y="130" width="390" height="180" as="geometry" />
        </mxCell>

        <mxCell id="w3" value="&lt;b&gt;Exposes a fixed toolset&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;font face=&quot;Courier New&quot;&gt;corpus-graph&lt;/font&gt; exposes 4 tools:&lt;br/&gt;&#160;&#160;· &lt;font face=&quot;Courier New&quot;&gt;cypher(query)&lt;/font&gt;&lt;br/&gt;&#160;&#160;· &lt;font face=&quot;Courier New&quot;&gt;neighbors(node_id, depth)&lt;/font&gt;&lt;br/&gt;&#160;&#160;· &lt;font face=&quot;Courier New&quot;&gt;path(src, dst)&lt;/font&gt;&lt;br/&gt;&#160;&#160;· &lt;font face=&quot;Courier New&quot;&gt;list_schema()&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Read-only guardrail:&lt;/b&gt; CREATE / MERGE / DELETE / SET rejected before the query reaches Kuzu." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E2761;strokeWidth=2;fontColor=#1E2761;fontSize=12;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="860" y="130" width="390" height="180" as="geometry" />
        </mxCell>

        <!-- ================= SECTION 2: ONE CALL ================= -->
        <mxCell id="s2-label" value="2 · ONE CALL, TOP → BOTTOM  ·  TCR agent asks:  which controls mitigate T-OTA-P01-T ?" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#1E2761;letterSpacing=2;" vertex="1" parent="1">
          <mxGeometry x="50" y="345" width="1200" height="20" as="geometry" />
        </mxCell>

        <!-- Step 1: agent -->
        <mxCell id="badge1" value="①" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1E2761;strokeColor=#1E2761;fontColor=#FFFFFF;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="380" width="34" height="34" as="geometry" />
        </mxCell>
        <mxCell id="step1" value="&lt;b&gt;TCR agent (parent process) calls a tool&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#666&quot;&gt;inside &lt;font face=&quot;Courier New&quot;&gt;framework/agents/threat_control_risk.py&lt;/font&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px;color:#1E2761&quot;&gt;rows = await session.call_tool(&#10;&#160;&#160;&quot;cypher&quot;,&#10;&#160;&#160;{&quot;query&quot;: &quot;MATCH (t:Threat {id:'T-OTA-P01-T'})-[:MITIGATED_BY]-&gt;(c:Control) RETURN c.id, c.name&quot;}&#10;)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E2761;strokeWidth=2;fontColor=#1E2761;fontSize=12;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="380" width="1150" height="120" as="geometry" />
        </mxCell>

        <!-- arrow 1→2 -->
        <mxCell id="a12" value="JSON-RPC line written to child stdin" style="edgeStyle=none;html=1;endArrow=classic;endFill=1;strokeColor=#1E2761;strokeWidth=2;fontSize=10;fontColor=#1E2761;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="650" y="500" as="sourcePoint" />
            <mxPoint x="650" y="540" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Step 2: MCP server -->
        <mxCell id="badge2" value="②" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1E2761;strokeColor=#1E2761;fontColor=#FFFFFF;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="540" width="34" height="34" as="geometry" />
        </mxCell>
        <mxCell id="step2" value="&lt;b&gt;corpus-graph MCP server (child process) receives the tool call&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;color:#666&quot;&gt;inside &lt;font face=&quot;Courier New&quot;&gt;framework/mcp_servers/corpus_graph.py&lt;/font&gt;&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&#160;&#160;· MCP SDK parses the JSON-RPC frame, dispatches to the &lt;font face=&quot;Courier New&quot;&gt;cypher&lt;/font&gt; handler&lt;br/&gt;&#160;&#160;· &lt;b&gt;read-only guard&lt;/b&gt; scans the query — refuses if it matches CREATE / MERGE / DELETE / SET / DROP&lt;br/&gt;&#160;&#160;· query passes → hand off to the in-process Kuzu connection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E2761;strokeWidth=2;fontColor=#1E2761;fontSize=12;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="540" width="1150" height="120" as="geometry" />
        </mxCell>

        <!-- arrow 2→3 -->
        <mxCell id="a23" value="conn.execute(query)  ·  Kuzu runs in-process, same address space as the MCP server" style="edgeStyle=none;html=1;endArrow=classic;endFill=1;strokeColor=#1E2761;strokeWidth=2;fontSize=10;fontColor=#1E2761;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="650" y="660" as="sourcePoint" />
            <mxPoint x="650" y="700" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Step 3: Kuzu -->
        <mxCell id="badge3" value="③" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1E2761;strokeColor=#1E2761;fontColor=#FFFFFF;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="700" width="34" height="34" as="geometry" />
        </mxCell>
        <mxCell id="step3" value="&lt;b&gt;Kuzu (embedded, backed by files under stores/kuzu/) executes the MATCH&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&#160;&#160;· walks the graph: Threat T-OTA-P01-T → :MITIGATED_BY → Control&lt;br/&gt;&#160;&#160;· returns 2 rows to the MCP server&lt;br/&gt;&lt;br/&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px;color:#1E2761&quot;&gt;[ {&quot;c.id&quot;: &quot;CTRL:crc-32-image-check&quot;, &quot;c.name&quot;: &quot;CRC-32 image check&quot;},&#10;&#160;&#160;{&quot;c.id&quot;: &quot;CTRL:verify-signature&quot;,&#160;&#160;&quot;c.name&quot;: &quot;OTA signature verify&quot;} ]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CADCFC;strokeColor=#1E2761;strokeWidth=2;fontColor=#1E2761;fontSize=12;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="700" width="1150" height="140" as="geometry" />
        </mxCell>

        <!-- arrow 3→4 -->
        <mxCell id="a34" value="rows serialized as a JSON-RPC response line, written to child stdout" style="edgeStyle=none;html=1;endArrow=classic;endFill=1;strokeColor=#1E2761;strokeWidth=2;dashed=1;fontSize=10;fontColor=#1E2761;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="650" y="840" as="sourcePoint" />
            <mxPoint x="650" y="880" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Step 4: agent resumes -->
        <mxCell id="badge4" value="④" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFAD1F;strokeColor=#FFAD1F;fontColor=#FFFFFF;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="880" width="34" height="34" as="geometry" />
        </mxCell>
        <mxCell id="step4" value="&lt;b&gt;TCR agent resumes with the rows and feeds them into the gpt-4o prompt&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;The two real control ids (&lt;font face=&quot;Courier New&quot;&gt;CTRL:crc-32-image-check&lt;/font&gt;, &lt;font face=&quot;Courier New&quot;&gt;CTRL:verify-signature&lt;/font&gt;) are pasted into the user message.&lt;br/&gt;Gap analysis therefore references controls that actually exist in the graph — no hallucinated control names, and the &lt;i&gt;citation guardrail&lt;/i&gt; can later verify every id it sees against Kuzu." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3D6;strokeColor=#FFAD1F;strokeWidth=2;fontColor=#1E2761;fontSize=12;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="880" width="1150" height="110" as="geometry" />
        </mxCell>

        <!-- ================= SECTION 3: HOW STARTED ================= -->
        <mxCell id="s3-label" value="3 · HOW THE MCP SERVER IS STARTED" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#1E2761;letterSpacing=2;" vertex="1" parent="1">
          <mxGeometry x="50" y="1010" width="700" height="20" as="geometry" />
        </mxCell>

        <mxCell id="how1" value="&lt;b&gt;A) Automatic during&#160;&lt;font face=&quot;Courier New&quot;&gt;sra draft&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;The pipeline's async context manager spawns all 3 MCP servers as child processes and holds the stdio pipes open for the run:&lt;br/&gt;&lt;br/&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:10px;color:#333&quot;&gt;async with stdio_client(&#10;&#160;&#160;StdioServerParameters(&#10;&#160;&#160;&#160;&#160;command=&quot;python&quot;,&#10;&#160;&#160;&#160;&#160;args=[&quot;-m&quot;, &quot;framework.mcp_servers.corpus_graph&quot;],&#10;&#160;&#160;)&#10;) as (read, write):&#10;&#160;&#160;session = ClientSession(read, write)&#10;&#160;&#160;await session.initialize()&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;Child processes are torn down when the pipeline exits." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E2761;strokeWidth=2;fontColor=#1E2761;fontSize=11;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="1040" width="590" height="180" as="geometry" />
        </mxCell>

        <mxCell id="how2" value="&lt;b&gt;B) Manual, for external MCP clients&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;The same server is runnable standalone on stdio:&lt;br/&gt;&lt;br/&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:10px;color:#333&quot;&gt;$ sra mcp graph&#10;# corpus-graph MCP server on stdio&#10;# waits for an MCP client to connect&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;Any MCP-compatible client — Claude Code, Cursor, Continue — can point at this command and query the corpus with the same 4 tools. Same read-only guard, same schema.&lt;br/&gt;&lt;br/&gt;This is how you get an interactive &quot;chat with my SRA corpus&quot; session outside the framework." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E2761;strokeWidth=2;fontColor=#1E2761;fontSize=11;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="660" y="1040" width="590" height="180" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
