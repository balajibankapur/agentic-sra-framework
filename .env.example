# Copy to .env and fill in. Never commit .env.

# --- Embeddings (Step 2: vector indexer) ---
# OpenAI is the default embedding provider for text-embedding-3-large.
OPENAI_API_KEY=

# --- LLM providers for the agents (any subset — LiteLLM picks based on config.yaml) ---
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=

# --- Optional: override default store locations ---
# SRA_CHROMA_DIR=./stores/chroma
# SRA_KUZU_DIR=./stores/kuzu
# SRA_INPUT_DIR=./input
